<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <!-- Grid principal: organiza el contenido en dos columnas. -->
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Columna izquierda de ancho fijo para el formulario. -->
            <ColumnDefinition Width="280"/>
            <!-- Columna derecha: ocupa el espacio que quede disponible. -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel del formulario para introducir un empleado. -->
        <Border Grid.Column="0"
                Background="#F4F4F6"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <!-- El texto introducido se guarda en la propiedad NuevoNombre.
                     UpdateSourceTrigger hace que se actualice mientras se escribe. -->
                <Label Content="Nombre del empleado: "/>
                <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6"
                         Margin="0,0,0,10"/>

                <!-- Muestra las opciones de Departamentos.
                     La opción elegida se guarda en NuevoDepartamento. -->
                <Label Content="Departamento: "/>
                <ComboBox ItemsSource="{Binding Departamentos}"
                          SelectedItem="{Binding NuevoDepartamento}"
                          Padding="6"
                          Margin="0,0,0,10"/>

                <!-- El estado marcado o desmarcado se enlaza con JornadaCompleta. -->
                <CheckBox Content="Jornada Completada?"
                          IsChecked="{Binding JornadaCompleta}"
                          Margin="0,5,0,20" />

                <!-- Al pulsar, ejecuta AgregarEmpleadoCommand.
                     El comando y su lógica deben estar definidos en el código asociado
                     o en el objeto que actúe como contexto de datos. -->
                <Button Content="Agregar Empleado"
                        Command="{Binding AgregarEmpleadoCommand}"
                        Padding="8"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Panel derecho: presenta la lista y los datos del empleado seleccionado. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Fila superior para el título, con la altura que necesite el texto. -->
                <RowDefinition Height="Auto"/>
                <!-- Fila central: ocupa el espacio disponible para la lista. -->
                <RowDefinition Height="*"/>
                <!-- Fila inferior para mostrar la selección. -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título de la lista. -->
            <TextBlock Grid.Row="0"
                       Text="Lista de empleados (mockup)"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- ItemsSource muestra los elementos de Empleados.
                 SelectedItem guarda la fila elegida en EmpleadoSeleccionado. -->
            <ListView Grid.Row="1"
                      ItemsSource="{Binding Empleados}"
                      SelectedItem="{Binding EmpleadoSeleccionado}">
                <!-- Define las columnas visibles de la lista. -->
                <ListView.View>
                    <GridView>
                        <!-- Cada columna muestra una propiedad del empleado actual. -->
                        <GridViewColumn Header="ID"
                                        DisplayMemberBinding="{Binding Id}"
                                        Width="40"/>
                        <GridViewColumn Header="Nombre"
                                        DisplayMemberBinding="{Binding Nombre}"
                                        Width="160"/>
                        <GridViewColumn Header="Departamento"
                                        DisplayMemberBinding="{Binding Departamento}"
                                        Width="110"/>
                        <GridViewColumn Header="Salario"
                                        DisplayMemberBinding="{Binding Salario, StringFormat={}{0:C}}"
                                        Width="80"/>
                        <GridViewColumn Header="Jornada Completa"
                                        DisplayMemberBinding="{Binding JornadaCompleta}"
                                        Width="60"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Muestra el nombre del empleado seleccionado.
                 FallbackValue presenta "Ninguno" si no hay un valor disponible.
                 Run permite dar formato distinto a fragmentos del mismo texto. -->
            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold">
                <Run Text="Seleccionado: "/>
                <Run Text="{Binding EmpleadoSeleccionado.Nombre, FallbackValue='Ninguno'}"
                     Foreground="#007ACC"
                     FontWeight="Bold"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>