<Window x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="WPF TechStore: Demo MVVM Toolkit" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: Formulario de alta -->
        <Border Grid.Column="0" Background="#F4F4F6" CornerRadius="8" Padding="15" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="Añadir Producto" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Label + TextBox -->
                <Label Content="Nombre del Producto:" />
                <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="6" Margin="0,0,0,10"/>

                <!-- Label + ComboBox -->
                <Label Content="Categoría:" />
                <ComboBox ItemsSource="{Binding Categorias}" 
                          SelectedItem="{Binding NuevaCategoria}" 
                          Padding="6" Margin="0,0,0,10"/>

                <!-- CheckBox -->
                <CheckBox Content="Disponible en stock" 
                          IsChecked="{Binding NuevoDisponible}" 
                          Margin="0,5,0,20"/>

                <!-- Button vinculado al Command -->
                <Button Content="Añadir a la lista" 
                        Command="{Binding AgregarProductoCommand}"
                        Padding="8" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- PANEL DERECHO: Lista de productos -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Listado de Productos (Mockup)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- ListView con GridView -->
            <ListView Grid.Row="1" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="40"/>
                        <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Nombre}" Width="160"/>
                        <GridViewColumn Header="Categoría" DisplayMemberBinding="{Binding Categoria}" Width="110"/>
                        <GridViewColumn Header="Precio" DisplayMemberBinding="{Binding Precio, StringFormat={}{0:C}}" Width="80"/>
                        <GridViewColumn Header="Stock" DisplayMemberBinding="{Binding Disponible}" Width="60"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- TextBlock inferior con información del elemento seleccionado -->
            <TextBlock Grid.Row="2" Margin="0,10,0,0" FontWeight="SemiBold">
                <Run Text="Seleccionado: " />
                <Run Text="{Binding ProductoSeleccionado.Nombre, FallbackValue='Ninguno'}" Foreground="#007ACC" FontWeight="Bold"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>