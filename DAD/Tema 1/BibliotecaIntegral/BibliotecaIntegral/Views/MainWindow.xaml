<Window x:Class="BibliotecaIntegral.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BibliotecaIntegral"
        mc:Ignorable="d"
        Language="es-ES"
        Title="Biblioteca Digital" Height="450" Width="900">
    <!-- grid principal con 3 filas -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fila 0: formulario horizontal dentro de un Border -->
        <Border Grid.Row="0"
                Background="#F4F4F6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Label Content="Título:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NuevoTitulo,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Width="170"
                         Padding="5"
                         Margin="0,0,12,0"/>

                <Label Content="Género:" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Generos}"
                          SelectedItem="{Binding NuevoGenero}"
                          Width="110"
                          Padding="5"
                          Margin="0,0,12,0"/>

                <Label Content="Precio:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding NuevoPrecio,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Width="60"
                         Padding="5"
                         Margin="0,0,12,0"/>

                <CheckBox Content="Disponible"
                          IsChecked="{Binding NuevoDisponible}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>

                <Button Content="Añadir libro"
                        Command="{Binding AgregarLibroCommand}"
                        Padding="14,6"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Fila 1: lista de libros -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Libros}"
                  SelectedItem="{Binding LibroSeleccionado}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID"
                                    DisplayMemberBinding="{Binding Id}"
                                    Width="40"/>
                    <GridViewColumn Header="Título"
                                    DisplayMemberBinding="{Binding Titulo}"
                                    Width="300"/>
                    <GridViewColumn Header="Género"
                                    DisplayMemberBinding="{Binding Genero}"
                                    Width="120"/>
                    <GridViewColumn Header="Precio"
                                    DisplayMemberBinding="{Binding PrecioAlquiler,
                                                                   StringFormat={}{0:C}}"
                                    Width="80"/>
                    <GridViewColumn Header="Disponible"
                                    DisplayMemberBinding="{Binding Disponibilidad}"
                                    Width="90"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Fila 2: barra de estado -->
        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   FontWeight="SemiBold">
            <Run Text="Seleccionado: "/>
            <Run Text="{Binding LibroSeleccionado.Titulo, FallbackValue='Ninguno'}"
                 Foreground="#007ACC"
                 FontWeight="Bold"/>
        </TextBlock>
    </Grid>
</Window>
